AIRFLOW_UID=50000
# The three secrets below have no default: `docker compose` refuses to start while one of them is empty.
# Fernet key (32 random bytes, url-safe base64): python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=
# Secret that signs the interface's tokens: python -c "import secrets; print(secrets.token_urlsafe(48))"
AIRFLOW__API_AUTH__JWT_SECRET=
# Password of the user "airflow" of the web interface (published on 127.0.0.1 only)
_AIRFLOW_WWW_USER_PASSWORD=
